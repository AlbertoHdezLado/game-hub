{
  "rewrites": [
    { "source": "/secret-code/join/:code", "destination": "/games/secret-code/index.html" },
    { "source": "/games/secret-code/rooms/:code", "destination": "/games/secret-code/index.html" },
    { "source": "/games/secret-code/rooms/:code/join", "destination": "/games/secret-code/index.html" },
    { "source": "/((?!api|data|resources).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/version.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
